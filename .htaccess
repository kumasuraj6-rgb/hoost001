# ====================================================================
# Hostinger Production .htaccess - Vite / React SPA + Node.js Reverse Proxy
# ====================================================================

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # ------------------------------------------------------------------
  # 1. Reverse Proxy: Force ALL /api/ requests to the Node.js Process
  # ------------------------------------------------------------------
  # Proxies /api or /api/* to localhost Node server running on port 3000
  <IfModule mod_proxy.c>
    RewriteCond %{REQUEST_URI} ^/api(/.*)?$ [NC]
    RewriteRule ^api/?(.*)$ http://127.0.0.1:3000/api/$1 [P,L,NE]
  </IfModule>

  # ------------------------------------------------------------------
  # 2. Strict /api Guard (Prevent HTML fallback if proxy fails)
  # ------------------------------------------------------------------
  # Explicitly prevent ANY /api request from falling through to index.html
  RewriteCond %{REQUEST_URI} ^/api(/.*)?$ [NC]
  RewriteRule ^ - [R=503,L]

  # ------------------------------------------------------------------
  # 3. Serve Real Static Files Directly (JS, CSS, Images, Fonts, etc.)
  # ------------------------------------------------------------------
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # ------------------------------------------------------------------
  # 4. SPA Client-Side Routing Fallback
  # ------------------------------------------------------------------
  # Only non-API, non-file requests are routed to index.html
  RewriteRule ^ index.html [L]
</IfModule>

# ------------------------------------------------------------------
# Hostinger Apache Proxy Directives (when supported)
# ------------------------------------------------------------------
<IfModule mod_proxy_http.c>
  ProxyPreserveHost On
  ProxyRequests Off
</IfModule>

# ------------------------------------------------------------------
# Security & Performance Headers
# ------------------------------------------------------------------
Options -Indexes

<IfModule mod_headers.c>
  # Prevent MIME sniffing
  Header set X-Content-Type-Options "nosniff"
  # Prevent Clickjacking inside unauthorized iframes
  Header set X-Frame-Options "SAMEORIGIN"
  # XSS protection
  Header set X-XSS-Protection "1; mode=block"
  # Referrer policy
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
