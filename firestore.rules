rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ----------------------------------------------------
    // GLOBAL SECURITY PRIMITIVES & IDENTITY HELPERS
    // ----------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Hardened Admin check: Custom Claims, verified admin emails, or admin directory
    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.admin == true) ||
        (request.auth.token.email == 'ms0736687@gmail.com') ||
        (request.auth.token.email == 'skgsurajshahu317@gmail.com') ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // ----------------------------------------------------
    // VALIDATION HELPERS
    // ----------------------------------------------------

    function isValidProduct(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
             data.price is number && data.price >= 0 &&
             data.category is string && data.category.size() <= 100 &&
             data.inStock is bool;
    }

    function isValidOrder(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.customerEmail is string && data.customerEmail.size() <= 150 &&
             data.totalAmount is number && data.totalAmount >= 0 &&
             data.orderStatus is string && data.orderStatus.size() <= 50 &&
             data.paymentStatus is string && data.paymentStatus.size() <= 50;
    }

    function isValidCustomer(data) {
      return data.uid is string && data.uid.size() <= 128 &&
             data.email is string && data.email.size() <= 150 &&
             (!('role' in data) || data.role == 'CUSTOMER' || isAdmin());
    }

    function isValidCoupon(data) {
      return data.code is string && data.code.size() > 0 && data.code.size() <= 50 &&
             data.discountType in ['PERCENTAGE', 'FLAT', 'FIXED'] &&
             data.discountValue is number && data.discountValue >= 0 &&
             data.isActive is bool;
    }

    function isValidReturn(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.orderId is string && data.orderId.size() <= 128 &&
             data.customerEmail is string && data.customerEmail.size() <= 150 &&
             data.reason is string && data.reason.size() <= 1000 &&
             data.status in ['REQUESTED', 'UNDER_REVIEW', 'PENDING', 'APPROVED', 'REJECTED', 'PICKED_UP', 'REFUND_INITIATED', 'REFUND_COMPLETED', 'REFUNDED'];
    }

    // ----------------------------------------------------
    // 1. DEFAULT-DENY GLOBAL SAFETY NET
    // ----------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }

    // ----------------------------------------------------
    // 2. PRODUCTS COLLECTION (Catalog & Inventory)
    // Public read for customer browsing; Admin-only write/delete
    // ----------------------------------------------------
    match /products/{productId} {
      allow get: if isValidId(productId);
      allow list: if true;
      allow create: if isAdmin() && isValidId(productId) && isValidProduct(incoming());
      allow update: if isAdmin() && isValidId(productId) && isValidProduct(incoming());
      allow delete: if isAdmin() && isValidId(productId);
    }

    // ----------------------------------------------------
    // 3. ORDERS COLLECTION
    // Customer can only view/query their own orders; Admin has full management
    // Customers can create orders; Admin updates/deletes
    // ----------------------------------------------------
    match /orders/{orderId} {
      allow get: if isValidId(orderId) && (
        isAdmin() ||
        (isSignedIn() && (resource.data.customerId == request.auth.uid || resource.data.customerEmail == request.auth.token.email))
      );
      allow list: if isAdmin() || (
        isSignedIn() && (
          resource.data.customerId == request.auth.uid ||
          resource.data.customerEmail == request.auth.token.email
        )
      );
      allow create: if isValidId(orderId) && isValidOrder(incoming()) && (
        isAdmin() ||
        (isSignedIn() && (incoming().customerId == request.auth.uid || incoming().customerEmail == request.auth.token.email)) ||
        (!isSignedIn() && incoming().customerEmail.size() > 0)
      );
      allow update: if isAdmin() && isValidId(orderId) && isValidOrder(incoming());
      allow delete: if isAdmin() && isValidId(orderId);
    }

    // ----------------------------------------------------
    // 4. USERS (Customer Profiles, Addresses, Cart, Wishlist)
    // Private to the authenticated owner; Admin can view all
    // ----------------------------------------------------
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(userId) && isOwner(userId) && isValidCustomer(incoming());
      allow update: if isValidId(userId) && (
        (isOwner(userId) && isValidCustomer(incoming()) && (!('role' in incoming()) || incoming().role == existing().role || incoming().role == 'CUSTOMER')) ||
        isAdmin()
      );
      allow delete: if isAdmin() && isValidId(userId);

      // Customer subcollection: Addresses
      match /addresses/{addressId} {
        allow get, list, create, update, delete: if isValidId(userId) && isValidId(addressId) && (isOwner(userId) || isAdmin());
      }

      // Customer subcollection: Cart
      match /cart/{cartItemId} {
        allow get, list, create, update, delete: if isValidId(userId) && isValidId(cartItemId) && isOwner(userId);
      }

      // Customer subcollection: Wishlist
      match /wishlist/{itemId} {
        allow get, list, create, update, delete: if isValidId(userId) && isValidId(itemId) && isOwner(userId);
      }
    }

    // ----------------------------------------------------
    // 5. CUSTOMERS COLLECTION (Customer records)
    // Protected: customer can only read/manage their own record
    // ----------------------------------------------------
    match /customers/{customerId} {
      allow get: if isValidId(customerId) && (
        isOwner(customerId) ||
        isAdmin() ||
        (isSignedIn() && resource.data.email == request.auth.token.email)
      );
      allow list: if isAdmin();
      allow create: if isValidId(customerId) && (
        isOwner(customerId) ||
        isAdmin() ||
        (isSignedIn() && incoming().email == request.auth.token.email)
      );
      allow update: if isValidId(customerId) && (
        isAdmin() ||
        (isOwner(customerId) && (!('role' in incoming()) || incoming().role == existing().role))
      );
      allow delete: if isAdmin() && isValidId(customerId);
    }

    // ----------------------------------------------------
    // 6. COUPONS COLLECTION
    // Public read for discount validation; Admin-only write
    // ----------------------------------------------------
    match /coupons/{couponId} {
      allow get: if isValidId(couponId);
      allow list: if true;
      allow create: if isAdmin() && isValidId(couponId) && isValidCoupon(incoming());
      allow update: if isAdmin() && isValidId(couponId) && isValidCoupon(incoming());
      allow delete: if isAdmin() && isValidId(couponId);
    }

    // ----------------------------------------------------
    // 7. RETURNS / EXCHANGES
    // Customers can view and submit their own requests; Admin approves/updates
    // ----------------------------------------------------
    match /returns/{returnId} {
      allow get: if isValidId(returnId) && (
        isAdmin() ||
        (isSignedIn() && (resource.data.customerEmail == request.auth.token.email || resource.data.customerId == request.auth.uid))
      );
      allow list: if isAdmin() || (
        isSignedIn() && (resource.data.customerEmail == request.auth.token.email || resource.data.customerId == request.auth.uid)
      );
      allow create: if isValidId(returnId) && isValidReturn(incoming()) && (
        isAdmin() ||
        (isSignedIn() && (incoming().customerEmail == request.auth.token.email || incoming().customerId == request.auth.uid))
      );
      allow update: if isAdmin() && isValidId(returnId) && isValidReturn(incoming());
      allow delete: if isAdmin() && isValidId(returnId);
    }

    // ----------------------------------------------------
    // 8. SETTINGS COLLECTION (Store branding, policies, delivery fees)
    // Public read for store metadata; Admin-only write
    // ----------------------------------------------------
    match /settings/{settingId} {
      allow get: if isValidId(settingId);
      allow list: if true;
      allow create, update, delete: if isAdmin() && isValidId(settingId);
    }

    // ----------------------------------------------------
    // 9. ADMINS DIRECTORY
    // Strictly Admin-only
    // ----------------------------------------------------
    match /admins/{adminId} {
      allow get, list, create, update, delete: if isAdmin() && isValidId(adminId);
    }

    // ----------------------------------------------------
    // 10. AUDIT LOGS
    // Admin read; client create for event tracking; immutable updates/deletes
    // ----------------------------------------------------
    match /audit_logs/{logId} {
      allow get, list: if isAdmin();
      allow create: if isValidId(logId);
      allow update, delete: if false;
    }

    // ----------------------------------------------------
    // 11. OTP & PASSWORD RESET (SERVER-ONLY)
    // Denied from client SDK; only accessed by backend/Admin SDK
    // ----------------------------------------------------
    match /otps/{otpId} {
      allow read, write: if false;
    }

    match /password_resets/{resetId} {
      allow read, write: if false;
    }

    // ----------------------------------------------------
    // 12. TEST / HEALTH CHECK
    // Used by getDocFromServer on application startup
    // ----------------------------------------------------
    match /test/{testId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
